{
  "openapi": "3.0.0",
  "info": {
    "title": "Flyrank A4 Auth API",
    "version": "1.0.0",
    "description": "Authentication and protected route examples using Supabase Auth."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/public/info": {
      "get": {
        "summary": "Return public app info",
        "responses": {
          "200": {
            "description": "Public info returned successfully"
          }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "summary": "Sign up a user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "format": "password" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User created successfully" },
          "400": { "description": "Missing or invalid input" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Log in a user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "format": "password" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login succeeded" },
          "401": { "description": "Invalid login credentials" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Log out the currently authenticated user",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": { "description": "Logout succeeded" },
          "401": { "description": "Token missing or invalid" }
        }
      }
    },
    "/protected/profile": {
      "get": {
        "summary": "Read the authenticated user's profile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": { "description": "Profile returned successfully" },
          "401": { "description": "Access token required or invalid" }
        }
      }
    },
    "/protected/dashboard": {
      "get": {
        "summary": "Read protected dashboard data",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": { "description": "Dashboard data returned successfully" },
          "401": { "description": "Access token required or invalid" }
        }
      }
    }
  }
}
